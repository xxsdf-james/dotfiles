{{- /* Rendered empty without brew: chezmoi neither runs nor records an empty script, so the
     next apply after brew is installed runs it. A script that exited 0 there was recorded as
     done and never ran again until a Brewfile changed (backlog M3 K2, same fix as 20-gnome). */ -}}
{{- if stat "/home/linuxbrew/.linuxbrew/bin/brew" -}}
#!/usr/bin/env bash
# Install what the Brewfiles list (docs/philosophy.md §3). chezmoi re-runs this
# whenever a Brewfile changes; the hashes below are what it watches.
# Brewfile: {{ include "private_dot_homebrew/Brewfile" | sha256sum }}
{{- if eq .role "personal" }}
# Brewfile.personal: {{ include "private_dot_homebrew/Brewfile.personal" | sha256sum }}
{{- end }}
# Only installs; never removes. To find extras: brew bundle cleanup --file=... (dry run).
set -euo pipefail

BREW=/home/linuxbrew/.linuxbrew/bin/brew

# The VS Code cask (where the OS doesn't ship VS Code; see the Brewfile) is in a non-official
# tap, which brew 7 only loads once trusted. On Linux `brew bundle` loads it before applying a
# Brewfile `trusted: true` (brew 7.0.11), so trust that one cask here, not the whole tap.
if [ ! -x /usr/bin/code ]; then
    "$BREW" tap ublue-os/tap
    "$BREW" trust --cask ublue-os/tap/visual-studio-code-linux
fi

for f in "$HOME/.homebrew/Brewfile" "$HOME/.homebrew/Brewfile.personal"; do
    [ -f "$f" ] || continue
    echo "packages: brew bundle --file=$f"
    "$BREW" bundle install --file="$f" --no-upgrade
done
{{ end -}}
