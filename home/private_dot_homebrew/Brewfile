# Base packages for every full install (docs/philosophy.md §3).
# CLI tools from brew, GUI apps from Flathub (installed system-wide, like Bluefin's own lists).
# Personal-only apps are in Brewfile.personal. GNOME core apps come from the OS, so they aren't listed.
# Machine-only keeps go in ~/.homebrew/Brewfile.local: not in the repo, never installed by it,
# but read by the drift check so they don't show up as strays.
# Rule (§3): an app stays only if used in the last 12 months, or it's marked
# `# occasional: <reason>`. Pruned by usage 2026-10-30.

# --- CLI ---
brew "bat"
brew "chezmoi"
brew "eza"
brew "gh"
brew "neovim"
brew "ripgrep"      # needed by the nvim config (Telescope live grep)
brew "shellcheck"   # occasional: lints this repo's shell scripts
brew "syncthing"
brew "yt-dlp"

# Only where the OS doesn't ship them (Bluefin does), so each machine has one copy.
brew "fzf" unless File.executable?("/usr/bin/fzf")
brew "jq" unless File.executable?("/usr/bin/jq")
brew "starship" unless File.executable?("/usr/bin/starship")
cask "font-symbols-only-nerd-font" unless File.exist?("/usr/share/fonts/nerd-fonts/SymbolsNerdFont-Regular.ttf")   # icons for eza

# --- GUI: everyday ---
flatpak "com.brave.Browser"
flatpak "org.keepassxc.KeePassXC"
flatpak "md.obsidian.Obsidian"
flatpak "org.libreoffice.LibreOffice"
flatpak "org.mozilla.thunderbird_esr"
flatpak "io.missioncenter.MissionCenter"   # Ctrl+Shift+Esc
flatpak "org.videolan.VLC"                 # the one video player (2026-10-30)

# --- GUI: VS Code ---
# A brew cask, not the Flatpak: the sandbox gets in the way of terminals and dev containers.
# The cask comes from the Universal Blue tap (it works with brew on any distro).
# Skipped where the OS already ships it (Bluefin DX's RPM), so each machine has one copy.
unless File.executable?("/usr/bin/code")
  tap "ublue-os/tap"
  cask "visual-studio-code-linux"
end
